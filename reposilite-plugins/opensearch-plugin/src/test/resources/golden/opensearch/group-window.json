{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {"bool": {"should": [{"term": {"repository": "releases"}}], "minimum_should_match": 1}}
      ]
    }
  },
  "aggs": {
    "groups": {
      "composite": {
        "size": 40,
        "sources": [
          {"g": {"terms": {"field": "group_id_lc", "order": "asc"}}},
          {"a": {"terms": {"field": "artifact_id_lc", "order": "asc"}}},
          {"v": {"terms": {"field": "version_lc", "order": "desc"}}}
        ]
      },
      "aggs": {
        "display": {"top_hits": {"size": 1, "_source": {"includes": ["group_id", "artifact_id", "version"]}}},
        "lastModified": {"max": {"field": "last_modified"}},
        "sizeBytes": {"sum": {"field": "size_bytes"}}
      }
    }
  }
}
