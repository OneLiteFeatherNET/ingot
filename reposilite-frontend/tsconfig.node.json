{
  // @vue/tsconfig 0.9.1 ships no tsconfig.node.json, so its base file is extended and the library set is chosen here.
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "vite.config.js",
    "vitest.config.js",
    "playwright.config.js",
    "eslint.config.js",
    "nitro.config.ts",
    "scripts/**/*",
    "server/**/*",
    // The dashboard plugin imports the segment list of the router. A composite project must list every file it imports.
    "src/router/dashboard-segments.json",
    // The anchors reference generator (scripts/anchors-doc.ts) renders the page with this module.
    "src/anchors/render.ts",
    "fake-api/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "types": ["node"]
  }
}
