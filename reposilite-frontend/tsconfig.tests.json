{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.test.ts", "src/**/*.ts", "src/**/*.vue", "src/env.d.ts", "e2e/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "types": ["vite/client", "node"],
    // Mirrors tsconfig.app.json: the shipped declarations of this deep @jsonforms/core path, not its sources.
    "paths": {
      "@jsonforms/core/src/reducers": ["./node_modules/@jsonforms/core/lib/reducers/index.d.ts"]
    }
  }
}
