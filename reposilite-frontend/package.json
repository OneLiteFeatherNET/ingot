{
  "name": "reposilite-frontend",
  "version": "1.2.0",
  "repository": "https://github.com/OneLiteFeatherNET/ingot",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "eslint": "eslint \"src/**\" \"server/**\" nitro.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "e2e": "playwright test",
    "anchors:doc": "node scripts/anchors-doc.mjs",
    "build": "vite build",
    "build:dashboard": "INGOT_DASHBOARD_BUILD=1 vite build && nitro build",
    "serve": "vite preview",
    "fake-api": "nodemon fake-api/fake-ingot-backend.js",
    "full": "concurrently -k \"npm run fake-api\" \"vite\"",
    "license-check": "license-checker-rseidelsohn --production --summary --onlyAllow \"0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;ISC;MIT;MPL-2.0;Unlicense\""
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@dzikoysk/vue-vanilla": "^3.4.1",
    "@jsonforms/core": "^3.4.1",
    "@jsonforms/vue": "^3.4.1",
    "@material/material-color-utilities": "0.4.0",
    "@unhead/vue": "^3.3.1",
    "@vueform/toggle": "^2.1.4",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "downloadjs": "^1.4.7",
    "echarts": "^6.1.0",
    "extended-eventsource": "^2.1.0",
    "mime-types": "^3.0.2",
    "pretty-bytes": "^7.1.0",
    "simple-icons": "^16.35.0",
    "undici": "^8.12.4",
    "vue": "^3.5.44",
    "vue-axios": "^3.5.2",
    "vue-final-modal": "^4.5.5",
    "vue-router": "^5.1.0",
    "vue-upload-component": "^3.1.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "body-parser": "^2.4.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "express": "^5.3.0",
    "express-ws": "^5.0.2",
    "globals": "^17.6.0",
    "jsdoc": "^4.0.5",
    "jsdom": "^30.1.2",
    "json-server": "^0.17.4",
    "license-checker-rseidelsohn": "^5.0.1",
    "nitropack": "^2.13.6",
    "nodemon": "^3.1.14",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.6",
    "vitest": "^5.0.4",
    "ws": "^8.22.2"
  }
}
