{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue"],
  // Test helpers that import vitest are left out: a composite project cannot name vitest's types in its declarations.
  // Their tests move to tsconfig.tests.json with the test conversion.
  "exclude": ["src/**/*.test.*", "src/style-gate/**/*", "src/components/access/teamTestKit.js", "src/components/migration/testing.js"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Transition settings, removed in Phase 4 of migrate-dashboard-to-typescript. JavaScript is parsed so that
    // a .ts file can import it, but it is not checked.
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "types": ["vite/client"],
    // OptionalRenderer.vue imports a deep path of @jsonforms/core that points at the package's TypeScript sources,
    // which fail the strict settings. Types come from the shipped declarations instead. Vite ignores this mapping.
    "paths": {
      "@jsonforms/core/src/reducers": ["./node_modules/@jsonforms/core/lib/reducers/index.d.ts"]
    }
  }
}
