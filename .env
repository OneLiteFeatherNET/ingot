# User and group id the server runs as inside the container, and the owner the data
# directory is chowned to. 977 is the current default; the entrypoint warns that 999,
# which older Reposilite images used, stops working after 3.6.0.
#
# Point these at an existing owner only if you are migrating a data directory that is
# already owned by someone else, and expect the entrypoint to leave it alone then.
PUID=977
PGID=977
# Port to use
PORT=8080
# Memory limit for Ingot
MEMORY=64M
# JVM args
JAVA_COMPOSE_OPTS=
# Ingot args
INGOT_COMPOSE_OPTS=
